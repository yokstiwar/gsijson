{
  "version": 8,
  "name": "GSI Photo Custom",
  "sources": {
    "gsi-photo": {
      "type": "raster",
      "tiles": [
        "https://cyberjapandata.gsi.go.jp/xyz/seamlessphoto/{z}/{x}/{y}.jpg"
      ],
      "tileSize": 256,
      "attribution": "国土地理院"
    }
  },
  "layers": [
    {
      "id": "gsi-photo-layer",
      "type": "raster",
      "source": "gsi-photo",
      "minzoom": 2,
      "maxzoom": 18
    }
  ]
}
